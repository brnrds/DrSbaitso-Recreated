# Copy to .env.local for local development (`npm run dev`).
# On Vercel, set these under Project -> Settings -> Environment Variables.
# They are read ONLY by the server-side functions in api/ and never reach the browser.

# Required for speech: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional chat backend (defaults in api/_lib/chatBackend.ts). TTS always uses Gemini.
# CHAT_BACKEND=auto          # gemini | harness | auto
# CHAT_HARNESS_MODEL=anthropic/claude-sonnet-4.6
# CHAT_HARNESS_FALLBACK_MODELS=openai/gpt-5.4,google/gemini-3.8-flash
# Harness auth (Pi, auth=auto): AI_GATEWAY_API_KEY, VERCEL_OIDC_TOKEN, OPENAI_API_KEY, ANTHROPIC_API_KEY, or a host-native subscription when running locally.

# Optional model overrides (defaults in api/_lib/gemini.ts)
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Comma-separated models tried when the primary is overloaded or out of quota.
# Leave unset for the defaults; set to an empty value to disable fallbacks.
# GEMINI_CHAT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest
# GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts
